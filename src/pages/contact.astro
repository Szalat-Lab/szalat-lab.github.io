---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { url } from '../lib/url';
---

<BaseLayout
  title="Contact"
  description="Get in touch with the Szalat Lab at Boston Medical Center and Boston University: students, collaborators, and anyone interested in our work are welcome."
>
  <div class="container page">
    <header class="page-head">
      <h1>Contact</h1>
      <p class="lead">
        We are always glad to hear from people interested in plasma cell disorders, whether you want to train with us,
        work with us, or learn more about our research.
      </p>
    </header>

    <div class="layout">
      <section class="card email-card" aria-labelledby="email-title">
        <h2 id="email-title" class="label">Email</h2>
        <p>
          <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="hint">Raphael E. Szalat, MD, PhD · Principal Investigator</p>
      </section>

      <section class="card" aria-labelledby="where-title">
        <h2 id="where-title" class="label">Where we are</h2>
        <ul class="plain">
          {site.affiliations.map((a) => <li>{a}</li>)}
          <li>Boston, Massachusetts</li>
        </ul>
      </section>
    </div>

    <section class="block" aria-labelledby="join-title">
      <h2 id="join-title">Joining the lab</h2>
      <div class="prose">
        <!-- TODO: draft text for the PI to edit. -->
        <p>
          We welcome students at every stage who want to work on plasma cell disorders, including undergraduates,
          medical students, MD/PhD and PhD students looking for rotations or thesis labs, and postdoctoral fellows. Our
          projects span <a href={url('research/')}>single-cell and multiomic profiling of patient samples</a>,
          computational analysis, and clinical research in multiple myeloma and AL amyloidosis.
        </p>
        <p>
          If you are interested, email Dr. Szalat with a short note about your background and interests and, if you
          have one, a CV.
        </p>
      </div>
    </section>

    <section class="block" aria-labelledby="collab-title">
        <h2 id="collab-title">Collaborations</h2>
        <div class="prose">
          <p>
            We work with clinicians and with genomic and computational scientists at Boston Medical Center, Boston University, and institutions across the United States and Europe (see
            <a href={url('people/#collab-title')}>our collaborators</a>). If you see overlap with your work, or want to
            talk about samples, data, methods, or clinical trials, we would be glad to hear from you.
          </p>
          <p>
            Questions from anyone else interested in our research, including patients, families, and the press, are
            welcome too. For medical care, please contact Boston Medical Center directly rather than this email.
          </p>
        </div>
      </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-8) 0;
  }
  .lead {
    max-width: var(--measure);
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }
  .layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
  .card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .card h2 {
    margin-bottom: var(--space-3);
  }
  .email {
    font-size: var(--text-xl);
    font-weight: 550;
    overflow-wrap: anywhere;
  }
  .hint {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .plain {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }
  .block {
    margin-top: var(--space-8);
  }
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin-top: var(--space-4);
  }
</style>
