---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getConcepts, getConceptGraph, groupLabels, MIN_WORKS, MIN_SHARED, type ConceptGroup } from '../../lib/concepts';
import { getPublications } from '../../lib/publications';
import { url } from '../../lib/url';

const graph = await getConceptGraph();
const concepts = await getConcepts();
const total = (await getPublications()).length;
const maxW = Math.max(1, ...graph.edges.map((e) => e.weight));
const maxS = Math.max(0.01, ...graph.edges.map((e) => e.strength));
const pos = new Map(graph.nodes.map((n) => [n.id, n]));

// Node colors come from the decorative omics palette (see global.css).
const groupColor: Record<ConceptGroup, string> = {
  genomics: 'var(--omics-1)',
  biology: 'var(--omics-2)',
  clinical: 'var(--omics-3)',
  disease: 'var(--omics-4)',
  population: 'var(--omics-5)',
};
const groups = Object.keys(groupLabels) as ConceptGroup[];
---

<BaseLayout
  title="Concepts"
  description="A network of the main concepts in Raphael E. Szalat's publications, from multiple myeloma genomics to AL amyloidosis and clinical trials. Select a concept to see the related papers."
>
  <div class="container page">
    <header class="page-head">
      <h1>Concepts</h1>
      <p class="lead">
        The main subjects of Raphael E. Szalat's {total} papers and abstracts. Larger circles appear in more works;
        lines connect concepts that appear together. Select a concept to see its publications.
      </p>
      <ul class="legend" aria-label="Concept groups">
        {
          groups.map((g) => (
            <li>
              <span class="swatch" style={`background: ${groupColor[g]}`} aria-hidden="true" />
              {groupLabels[g]}
            </li>
          ))
        }
      </ul>
    </header>

    <figure class="graph-wrap">
      <div class="scroller">
        <svg
          class="graph"
          viewBox={`0 0 ${graph.width} ${graph.height}`}
          role="group"
          aria-label="Concept network. Each concept links to its publications."
        >
          <g class="edges" aria-hidden="true">
            {
              graph.edges.map((e) => {
                const a = pos.get(e.source)!;
                const b = pos.get(e.target)!;
                return (
                  <line
                    x1={a.x}
                    y1={a.y}
                    x2={b.x}
                    y2={b.y}
                    data-a={e.source}
                    data-b={e.target}
                    stroke-width={(0.75 + 2.75 * (e.weight / maxW)).toFixed(2)}
                    style={`opacity: ${(0.15 + 0.5 * (e.strength / maxS)).toFixed(2)}`}
                  />
                );
              })
            }
          </g>
          <g class="nodes">
            {
              graph.nodes.map((n) => (
                <a
                  class="node"
                  href={url(`concepts/${n.id}/`)}
                  data-id={n.id}
                  data-neighbors={n.neighbors.join(' ')}
                  aria-label={`${n.label}: ${n.works.length} works`}
                >
                  <circle cx={n.x} cy={n.y} r={n.r.toFixed(1)} style={`--c: ${groupColor[n.group]}`} />
                  {n.r >= 15 && (
                    <text x={n.x} y={n.y + 4} class="count" aria-hidden="true">
                      {n.works.length}
                    </text>
                  )}
                  <text x={n.x} y={n.y + n.r + 15} class="name" aria-hidden="true">
                    {n.label}
                  </text>
                </a>
              ))
            }
          </g>
        </svg>
      </div>
      <figcaption>
        Concepts in at least {MIN_WORKS} works are shown. Lines join each concept to the concepts it overlaps with most
        (at least {MIN_SHARED} shared works); thicker lines mean more shared works. Concepts are assigned from titles and
        PubMed subject terms.
      </figcaption>
    </figure>

    <section class="index" aria-labelledby="index-title">
      <h2 id="index-title">All concepts</h2>
      <div class="index-grid">
        {
          groups.map((g) => (
            <section aria-labelledby={`g-${g}`}>
              <h3 id={`g-${g}`} class="label">
                <span class="swatch" style={`background: ${groupColor[g]}`} aria-hidden="true" />
                {groupLabels[g]}
              </h3>
              <ul>
                {concepts
                  .filter((c) => c.group === g && c.works.length > 0)
                  .map((c) => (
                    <li>
                      <a href={url(`concepts/${c.id}/`)}>{c.label}</a>
                      <span class="n">{c.works.length}</span>
                    </li>
                  ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Highlight a concept and its neighbors on hover or keyboard focus.
  const svg = document.querySelector<SVGSVGElement>('svg.graph');
  if (svg) {
    const nodes = [...svg.querySelectorAll<SVGAElement>('a.node')];
    const lines = [...svg.querySelectorAll<SVGLineElement>('line')];
    const clear = () => {
      svg.classList.remove('active');
      for (const el of [...nodes, ...lines]) el.classList.remove('on');
    };
    const show = (node: SVGAElement) => {
      clear();
      const id = node.dataset.id!;
      const near = new Set([id, ...(node.dataset.neighbors ?? '').split(' ').filter(Boolean)]);
      svg.classList.add('active');
      for (const n of nodes) if (near.has(n.dataset.id!)) n.classList.add('on');
      for (const l of lines) if (l.dataset.a === id || l.dataset.b === id) l.classList.add('on');
    };
    for (const n of nodes) {
      n.addEventListener('mouseenter', () => show(n));
      n.addEventListener('focus', () => show(n));
      n.addEventListener('mouseleave', clear);
      n.addEventListener('blur', clear);
    }
  }
</script>

<style>
  .page {
    padding-block: var(--space-8) 0;
  }
  .lead {
    max-width: var(--measure);
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .legend li,
  .index h3 {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .graph-wrap {
    margin: var(--space-6) 0 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--color-surface) 100%, transparent), transparent 70%),
      var(--color-bg);
  }
  .scroller {
    overflow-x: auto;
  }
  .graph {
    width: 100%;
    min-width: 44rem;
    height: auto;
  }
  .edges line {
    stroke: var(--color-muted);
    transition: opacity var(--duration) var(--ease);
  }
  .node {
    cursor: pointer;
    transition: opacity var(--duration) var(--ease);
  }
  .node circle {
    fill: color-mix(in srgb, var(--c) 28%, transparent);
    stroke: var(--c);
    stroke-width: 1.5;
    transition: fill var(--duration) var(--ease);
  }
  .node:hover circle,
  .node:focus-visible circle {
    fill: color-mix(in srgb, var(--c) 55%, transparent);
  }
  .node:focus-visible {
    outline: none;
  }
  .node:focus-visible circle {
    stroke: var(--color-text);
    stroke-width: 2.5;
  }
  .node text {
    text-anchor: middle;
    pointer-events: none;
  }
  .name {
    fill: var(--color-text);
    font-size: 12px;
    font-weight: 500;
    /* Dark halo keeps labels legible where lines pass behind them. */
    paint-order: stroke;
    stroke: var(--color-bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .count {
    fill: var(--color-text);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .graph:global(.active) .node:not(:global(.on)) {
    opacity: 0.2;
  }
  .graph:global(.active) line:not(:global(.on)) {
    opacity: 0.04 !important;
  }
  .graph:global(.active) line:global(.on) {
    opacity: 0.8 !important;
    stroke: var(--color-text);
  }
  figcaption {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .index {
    margin-top: var(--space-8);
  }
  .index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-6);
    margin-top: var(--space-5);
  }
  .index h3 {
    margin-bottom: var(--space-3);
  }
  .index ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }
  .index li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  .n {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
</style>
