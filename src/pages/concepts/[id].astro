---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PubEntry from '../../components/PubEntry.astro';
import { getConcepts, groupLabels, type Concept } from '../../lib/concepts';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const concepts = await getConcepts();
  return concepts
    .filter((c) => c.works.length > 0)
    .map((concept) => {
      // Related concepts: those sharing the most works with this one.
      const keys = new Set(concept.works.map((w) => w.key));
      const related = concepts
        .filter((c) => c.id !== concept.id && c.works.length > 0)
        .map((c) => ({ c, shared: c.works.filter((w) => keys.has(w.key)).length }))
        .filter((r) => r.shared >= 2)
        .sort((a, b) => b.shared - a.shared)
        .slice(0, 8);
      return { params: { id: concept.id }, props: { concept, related } };
    });
}

interface Props {
  concept: Concept;
  related: { c: Concept; shared: number }[];
}
const { concept, related } = Astro.props;
const papers = concept.works.filter((p) => p.kind === 'paper');
const abstracts = concept.works.filter((p) => p.kind === 'abstract');
const sections = [
  { id: 'papers', title: 'Papers', pubs: papers },
  { id: 'abstracts', title: 'Abstracts & posters', pubs: abstracts },
].filter((s) => s.pubs.length > 0);
---

<BaseLayout
  title={`${concept.label} · Concepts`}
  description={`${concept.works.length} papers and abstracts by Raphael E. Szalat related to ${concept.label.toLowerCase()}.`}
>
  <div class="container page">
    <nav aria-label="Breadcrumb" class="crumb mono">
      <a href={url('concepts/')}>← All concepts</a>
    </nav>
    <header class="page-head">
      <p class="label">{groupLabels[concept.group]}</p>
      <h1>{concept.label}</h1>
      <p class="lead">
        {`${papers.length} ${papers.length === 1 ? 'paper' : 'papers'} and ${abstracts.length} ${abstracts.length === 1 ? 'abstract' : 'abstracts'} co-authored by Raphael E. Szalat.`} Current lab members are
        shown in <strong>bold</strong>.
      </p>
      {
        related.length > 0 && (
          <div class="related">
            <h2 class="label">Related concepts</h2>
            <ul>
              {related.map(({ c, shared }) => (
                <li>
                  <a href={url(`concepts/${c.id}/`)}>
                    {c.label} <span class="n">{shared}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </header>

    {
      sections.map((s) => (
        <section class="pub-section" aria-labelledby={`${s.id}-title`}>
          <h2 id={`${s.id}-title`}>
            {s.title} <span class="count mono">{s.pubs.length}</span>
          </h2>
          <ol>
            {s.pubs.map((p) => (
              <PubEntry pub={p} showYear />
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6) 0;
  }
  .crumb {
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }
  .page-head .label {
    margin-bottom: var(--space-3);
  }
  .lead {
    max-width: var(--measure);
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }
  .lead strong {
    color: var(--color-text);
  }
  .related {
    margin-top: var(--space-6);
  }
  .related ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .related a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: border-color var(--duration) var(--ease);
  }
  .related a:hover {
    border-color: var(--color-accent);
  }
  .n,
  .count {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0;
  }
  .pub-section {
    margin-top: var(--space-8);
  }
  .pub-section h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  ol {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
</style>
