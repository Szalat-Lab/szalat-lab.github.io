---
import BaseLayout from '../layouts/BaseLayout.astro';
import PubEntry from '../components/PubEntry.astro';
import { getPublications, byYear } from '../lib/publications';

const all = await getPublications();
const sections = [
  { id: 'papers', title: 'Papers', one: 'paper', noun: 'papers', pubs: all.filter((p) => p.kind === 'paper') },
  { id: 'abstracts', title: 'Abstracts & posters', one: 'abstract', noun: 'abstracts', pubs: all.filter((p) => p.kind === 'abstract') },
];
const years = [...new Set(all.map((p) => p.year))].sort((a, b) => b - a);
---

<BaseLayout
  title="Publications"
  description="Papers, meeting abstracts, and posters co-authored by Raphael E. Szalat and the Szalat Lab, on multiple myeloma, AL amyloidosis, and other plasma cell disorders."
>
  <div class="container page">
    <header class="page-head">
      <h1>Publications</h1>
      <p class="lead">
        Papers, meeting abstracts, and posters co-authored by Raphael E. Szalat, newest first. Current lab members
        are shown in <strong>bold</strong>.
      </p>
      <nav aria-label="Sections" class="jump mono">
        {
          sections.map((s) => (
            <a href={`#${s.id}`}>
              {s.title} <span class="n">({s.pubs.length})</span>
            </a>
          ))
        }
      </nav>
    </header>

    <form class="filters" role="search" aria-label="Filter publications" hidden>
      <div class="field">
        <label for="pub-year" class="label">Year</label>
        <select id="pub-year">
          <option value="">All years</option>
          {years.map((y) => <option value={y}>{y}</option>)}
        </select>
      </div>
      <div class="field grow">
        <label for="pub-q" class="label">Search title, authors, journal</label>
        <input id="pub-q" type="search" autocomplete="off" placeholder="e.g. amyloidosis, Munshi, Blood" />
      </div>
      <p class="status mono" role="status" aria-live="polite"></p>
    </form>

    {
      sections.map((s) => (
        <section id={s.id} class="pub-section" aria-labelledby={`${s.id}-title`} data-noun={s.noun} data-one={s.one}>
          <h2 id={`${s.id}-title`}>
            {s.title} <span class="count mono">{s.pubs.length}</span>
          </h2>
          {byYear(s.pubs).map(([year, pubs]) => (
            <section class="year-group" aria-labelledby={`${s.id}-${year}`}>
              <h3 id={`${s.id}-${year}`} class="year-head mono">
                {year}
              </h3>
              <ol>
                {pubs.map((p) => (
                  <PubEntry pub={p} />
                ))}
              </ol>
            </section>
          ))}
          <p class="empty" hidden>
            No {s.noun} match these filters.
          </p>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: the full list is in the HTML; this only hides entries.
  const form = document.querySelector<HTMLFormElement>('form.filters');
  if (form) {
    const year = form.querySelector<HTMLSelectElement>('#pub-year')!;
    const q = form.querySelector<HTMLInputElement>('#pub-q')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const sections = [...document.querySelectorAll<HTMLElement>('.pub-section')];
    const fold = (s: string) =>
      s
        .normalize('NFKD')
        .replace(/[̀-ͯ]/g, '')
        .toLowerCase();

    const apply = () => {
      const terms = fold(q.value).split(/\s+/).filter(Boolean);
      const y = year.value;
      const parts: string[] = [];
      for (const section of sections) {
        let shown = 0;
        for (const group of section.querySelectorAll<HTMLElement>('.year-group')) {
          let inGroup = 0;
          for (const li of group.querySelectorAll<HTMLElement>('li.pub')) {
            const match =
              (!y || li.dataset.year === y) && terms.every((t) => (li.dataset.search ?? '').includes(t));
            li.hidden = !match;
            if (match) inGroup++;
          }
          group.hidden = inGroup === 0;
          shown += inGroup;
        }
        section.querySelector<HTMLElement>('.count')!.textContent = String(shown);
        section.querySelector<HTMLElement>('.empty')!.hidden = shown > 0;
        parts.push(`${shown} ${shown === 1 ? section.dataset.one : section.dataset.noun}`);
      }
      status.textContent = terms.length || y ? `Showing ${parts.join(' and ')}` : '';
    };

    form.hidden = false;
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('input', apply);
  }
</script>

<style>
  .page {
    padding-block: var(--space-8) 0;
  }
  .lead {
    max-width: var(--measure);
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }
  .lead strong {
    color: var(--color-text);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }
  .jump .n {
    color: var(--color-muted);
  }

  .filters {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .field {
    display: grid;
    gap: var(--space-1);
  }
  .grow {
    flex: 1 1 16rem;
  }
  select,
  input {
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    font-size: var(--text-sm);
    transition: border-color var(--duration) var(--ease);
  }
  select:hover,
  input:hover {
    border-color: var(--color-muted);
  }
  input::placeholder {
    color: var(--color-muted);
  }
  .status {
    flex-basis: 100%;
    min-height: 1.2em;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .status:empty {
    display: none;
  }

  .pub-section {
    margin-top: var(--space-8);
    scroll-margin-top: var(--space-9);
  }
  .pub-section h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .count {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0;
  }
  .year-group {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-4);
    margin-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .year-head {
    padding-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
  }
  ol {
    padding: 0;
    list-style: none;
  }
  ol > :global(li:last-child) {
    border-bottom: 0;
  }
  .empty {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }
  @media (max-width: 48rem) {
    .year-group {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .filters {
      position: static;
    }
  }
</style>
