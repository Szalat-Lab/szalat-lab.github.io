---
// Static, decorative multi-omics background for the Home page. Three panels:
//   1. single-cell embedding (UMAP-style clusters + a pseudotime path)
//   2. expression heatmap (genes x clusters, block structure matches the clusters)
//   3. genome browser tracks (gene model, RNA coverage, ATAC peaks, copy number)
// Generated once at build time from a fixed seed; no client JS, no animation.

const W = 1440;
const H = 800;

// Deterministic PRNG (mulberry32) + Gaussian sampler.
function prng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = prng(20261007);
const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
const r1 = (x: number) => Math.round(x * 10) / 10;

// ---------- 1. Single-cell embedding ----------
type Pt = [number, number];
interface Cluster { c: Pt; s: Pt; rot: number; n: number; tone: number; contour?: boolean }
const clusters: Cluster[] = [
  { c: [930, 170], s: [52, 30], rot: 25, n: 120, tone: 1, contour: true },
  { c: [1060, 120], s: [30, 24], rot: 0, n: 60, tone: 5 },
  { c: [1150, 230], s: [46, 34], rot: -20, n: 110, tone: 2, contour: true },
  { c: [990, 320], s: [40, 22], rot: 10, n: 80, tone: 6 },
  { c: [850, 360], s: [30, 40], rot: 0, n: 70, tone: 3 },
  { c: [1110, 400], s: [50, 26], rot: 15, n: 100, tone: 4, contour: true },
  { c: [1225, 360], s: [22, 30], rot: 0, n: 45, tone: 7 },
  { c: [800, 230], s: [24, 18], rot: 0, n: 35, tone: 5 },
];
const dots: Record<number, string[]> = {};
const contours: { d: string; tone: number }[] = [];
for (const k of clusters) {
  const th = (k.rot * Math.PI) / 180;
  const at = (x: number, y: number): Pt => [k.c[0] + x * Math.cos(th) - y * Math.sin(th), k.c[1] + x * Math.sin(th) + y * Math.cos(th)];
  for (let i = 0; i < k.n; i++) {
    const [x, y] = at(gauss() * k.s[0], gauss() * k.s[1]);
    (dots[k.tone] ??= []).push(`M${Math.round(x)} ${Math.round(y)}h0`);
  }
  if (k.contour) {
    for (const scale of [1.7, 2.4]) {
      const p1 = rand() * 6.28;
      const p2 = rand() * 6.28;
      const pts: string[] = [];
      for (let j = 0; j < 64; j++) {
        const a = (j / 64) * Math.PI * 2;
        const w = 1 + 0.08 * Math.sin(3 * a + p1) + 0.05 * Math.sin(5 * a + p2);
        const [x, y] = at(Math.cos(a) * k.s[0] * scale * w, Math.sin(a) * k.s[1] * scale * w);
        pts.push(`${r1(x)} ${r1(y)}`);
      }
      contours.push({ d: `M${pts.join('L')}Z`, tone: k.tone });
    }
  }
}
// Pseudotime trajectory through four cluster centroids.
const path = [clusters[7]!.c, clusters[0]!.c, clusters[3]!.c, clusters[5]!.c];
const trajectory = `M${path[0]!.join(' ')}C${path[1]![0]} ${path[1]![1] - 40} ${path[2]![0] - 60} ${path[2]![1]} ${path[2]!.join(' ')}S${path[3]![0] - 40} ${path[3]![1] - 30} ${path[3]!.join(' ')}`;

// ---------- 2. Expression heatmap ----------
const HM = { x: 1290, y: 80, cols: 8, rows: 24, cell: 14, gap: 2 };
const heat: { x: number; y: number; tone: number; o: number }[] = [];
for (let r = 0; r < HM.rows; r++) {
  const block = Math.floor(r / 3); // each gene module is "on" in one cluster column
  for (let c = 0; c < HM.cols; c++) {
    const on = c === block % HM.cols;
    const v = Math.min(1, Math.max(0, (on ? 0.75 : 0.12) + gauss() * 0.12));
    heat.push({
      x: HM.x + c * (HM.cell + HM.gap),
      y: HM.y + r * (HM.cell + HM.gap),
      tone: clusters[c]!.tone,
      o: Math.round(v * 100) / 100,
    });
  }
}

// ---------- 3. Genome tracks ----------
const TX = { x0: 880, x1: 1420 };
const tracks = { gene: 545, rna: 595, atac: 650, cnv: 700 };
// Gene model: two genes with exons.
const genes = [
  { from: 921, to: 1115, exons: [[921, 937], [970, 980], [1016, 1029], [1070, 1088], [1107, 1115]] },
  { from: 1184, to: 1378, exons: [[1184, 1198], [1233, 1248], [1295, 1303], [1344, 1378]] },
];
const exonRects = genes.flatMap((g) => g.exons.map(([a, b]) => ({ x: a!, w: b! - a! })));
// RNA coverage: high over exons, low noise elsewhere.
const rnaPts: string[] = [];
for (let x = TX.x0; x <= TX.x1; x += 4) {
  const onExon = exonRects.some((e) => x >= e.x - 2 && x <= e.x + e.w + 2);
  const h = onExon ? 22 + rand() * 14 : rand() * 2.5;
  rnaPts.push(`${x} ${r1(tracks.rna - h)}`);
}
const rnaArea = `M${TX.x0} ${tracks.rna}L${rnaPts.join('L')}L${TX.x1} ${tracks.rna}Z`;
// ATAC: sharp peaks, mostly near gene starts.
const peakAt = [915, 923, 969, 1063, 1136, 1181, 1188, 1233, 1271, 1337, 1402];
const atacPts: string[] = [];
for (let x = TX.x0; x <= TX.x1; x += 2) {
  let h = rand() * 1.5;
  for (const p of peakAt) h += 30 * Math.exp(-((x - p) ** 2) / 15);
  atacPts.push(`${x} ${r1(tracks.atac - Math.min(h, 34))}`);
}
const atacArea = `M${TX.x0} ${tracks.atac}L${atacPts.join('L')}L${TX.x1} ${tracks.atac}Z`;
// Copy number: log2-ratio dots with segment means (gain / neutral / loss).
const segments = [
  { from: TX.x0, to: 1032, mean: 0 },
  { from: 1032, to: 1212, mean: -12, tone: 5 },
  { from: 1212, to: 1337, mean: 0 },
  { from: 1337, to: TX.x1, mean: 14, tone: 4 },
];
const cnvDots: string[] = [];
for (const s of segments) {
  for (let x = s.from; x < s.to; x += 5) cnvDots.push(`M${x} ${Math.round(tracks.cnv - s.mean + gauss() * 4)}h0`);
}
---

<svg class="hero-bg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="hero-grid" width="48" height="48" patternUnits="userSpaceOnUse">
      <path d="M48 0H0V48" fill="none" class="grid"></path>
    </pattern>
  </defs>
  <rect width={W} height={H} fill="url(#hero-grid)"></rect>

  <g class="embedding">
    {contours.map((c) => <path d={c.d} class="contour" style={`stroke: var(--omics-${c.tone})`} />)}
    <path d={trajectory} class="trajectory"></path>
    {Object.entries(dots).map(([tone, d]) => <path d={d.join('')} class="dots" style={`stroke: var(--omics-${tone})`} />)}
    <g class="axes">
      <path d="M770 500V452M770 500H818M814 496l4 4-4 4M766 456l4-4 4 4" class="axis"></path>
      <text x="826" y="504">UMAP 1</text>
      <text x="766" y="444" transform="rotate(-90 766 444)">UMAP 2</text>
    </g>
  </g>

  <g class="heatmap">
    {heat.map((h) => <rect x={h.x} y={h.y} width={HM.cell} height={HM.cell} rx="2" style={`fill: var(--omics-${h.tone}); opacity: ${h.o}`} />)}
    <text x={HM.x} y={HM.y - 12}>genes × clusters</text>
  </g>

  <g class="tracks">
    <path d={`M${TX.x0} ${tracks.gene}H${TX.x1}`} class="baseline"></path>
    {genes.map((g) => <path d={`M${g.from} ${tracks.gene}H${g.to}`} class="intron" />)}
    {exonRects.map((e) => <rect x={e.x} y={tracks.gene - 7} width={e.w} height="14" rx="1.5" class="exon" />)}
    <path d={rnaArea} class="rna"></path>
    <path d={atacArea} class="atac"></path>
    <path d={`M${TX.x0} ${tracks.cnv}H${TX.x1}`} class="baseline"></path>
    <path d={cnvDots.join('')} class="cnv-dots"></path>
    {
      segments.map((s) => (
        <path
          d={`M${s.from} ${tracks.cnv - s.mean}H${s.to}`}
          class="segment"
          style={s.tone ? `stroke: var(--omics-${s.tone})` : undefined}
        />
      ))
    }
    <text x={TX.x0 - 12} y={tracks.gene + 4} text-anchor="end">genes</text>
    <text x={TX.x0 - 12} y={tracks.rna - 4} text-anchor="end">RNA</text>
    <text x={TX.x0 - 12} y={tracks.atac - 4} text-anchor="end">ATAC</text>
    <text x={TX.x0 - 12} y={tracks.cnv + 4} text-anchor="end">CNV</text>
  </g>
</svg>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .grid {
    stroke: var(--motif-grid);
    stroke-width: 1;
  }
  text {
    fill: var(--motif-label);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .dots {
    fill: none;
    stroke-width: 4.5;
    stroke-linecap: round;
    opacity: 0.8;
  }
  .contour {
    fill: none;
    stroke-width: 1;
    opacity: 0.3;
  }
  .trajectory {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.25;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
    opacity: 0.35;
  }
  .axis {
    fill: none;
    stroke: var(--motif-label);
    stroke-width: 1.25;
  }

  .heatmap {
    opacity: 0.75;
  }

  .baseline {
    stroke: var(--motif-label);
    stroke-width: 1;
    opacity: 0.5;
  }
  .intron {
    stroke: var(--omics-2);
    stroke-width: 1.5;
    opacity: 0.8;
  }
  .exon {
    fill: var(--omics-2);
    opacity: 0.8;
  }
  .rna {
    fill: var(--omics-1);
    opacity: 0.55;
  }
  .atac {
    fill: var(--omics-3);
    opacity: 0.6;
  }
  .cnv-dots {
    fill: none;
    stroke: var(--motif-label);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.8;
  }
  .segment {
    stroke: var(--color-muted);
    stroke-width: 2;
    opacity: 0.9;
  }
</style>
