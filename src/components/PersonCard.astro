---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  person: CollectionEntry<'people'>;
  /** Larger side-by-side layout for the PI. */
  feature?: boolean;
}

const { person, feature = false } = Astro.props;
const d = person.data;
const { Content } = await render(person);
const hasBio = (person.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
const initials = d.name
  .split(/\s+/)
  .filter((w) => /^[A-Z]/.test(w) && !w.endsWith('.'))
  .map((w) => w[0])
  .join('');

const links = [
  d.email && { label: 'Email', href: `mailto:${d.email}` },
  d.orcid && { label: 'ORCID', href: `https://orcid.org/${d.orcid}` },
  d.scholar && { label: 'Google Scholar', href: d.scholar },
  d.github && { label: 'GitHub', href: d.github },
  d.linkedin && { label: 'LinkedIn', href: d.linkedin },
  d.website && { label: 'Profile', href: d.website },
].filter(Boolean) as { label: string; href: string }[];
---

<article class:list={['person', { feature }]} id={person.id}>
  <div class="photo">
    {
      d.photo ? (
        <Image
          src={d.photo}
          alt={d.photoAlt ?? `Portrait of ${d.name}`}
          width={feature ? 400 : 320}
          height={feature ? 500 : 400}
          fit="cover"
          position={d.photoPosition}
          densities={[1, 2]}
        />
      ) : (
        <div class="placeholder" role="img" aria-label={`No photo of ${d.name}`}>
          <span aria-hidden="true">{initials}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <h3 class="name">
      {d.name}{d.credentials && <span class="cred">, {d.credentials}</span>}
    </h3>
    <p class="role">{d.role}</p>
    {d.alumniNote && <p class="note">{d.alumniNote}</p>}
    <p class="short">{d.shortBio}</p>
    {
      hasBio && (
        <details class="bio">
          <summary>
            Full bio<span class="visually-hidden"> of {d.name}</span>
          </summary>
          <div class="prose">
            <Content />
          </div>
        </details>
      )
    }
    {
      links.length > 0 && (
        <ul class="links" aria-label={`Links for ${d.name}`}>
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .person {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    scroll-margin-top: var(--space-6);
  }
  .feature {
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .photo :global(img),
  .placeholder {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .placeholder {
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
  }
  .name {
    font-size: var(--text-lg);
  }
  .feature .name {
    font-size: var(--text-xl);
  }
  .cred {
    color: var(--color-muted);
    font-weight: 450;
  }
  .role {
    margin-top: var(--space-1);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .note {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .short {
    max-width: var(--measure);
    margin-top: var(--space-3);
    color: var(--color-muted);
  }
  .bio {
    margin-top: var(--space-3);
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
    transition: color var(--duration) var(--ease);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '+';
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-size: var(--text-xs);
  }
  details[open] summary::before {
    content: '−';
  }
  summary:hover {
    color: var(--color-accent-strong);
  }
  .prose {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
    padding-top: var(--space-2);
    font-size: var(--text-sm);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  .links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  @media (max-width: 40rem) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature .photo {
      max-width: 16rem;
    }
  }
</style>
